{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2023"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "jsxImportSource": "vue",
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "strict": true,
    "types": ["node"]
  },
  // `build.config.ts`, `vite.config.ts` and `vitest.config.ts` are covered by
  // `tsconfig.node.json`, which `check-types` runs as a separate pass. It is
  // deliberately not a project `reference`: references require `composite`,
  // and a composite project may not import files outside its own `include` —
  // which those configs do, from `./src`.
  "include": ["src", "test", "playground"]
}
