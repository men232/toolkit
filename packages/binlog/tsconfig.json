{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["ES2022"],

    // The suite uses `Buffer`, `__dirname`, `node:fs` and `node:path`.
    // TypeScript 6 does not auto-include `@types/*`; until vitest 4 these
    // arrived only because vitest 3 bundled vite as a regular dependency and
    // `vite/dist/node/index.d.ts` carries `/// <reference types="node" />`.
    // vitest 4 makes vite a peer, so that accident is gone and the dependency
    // has to be stated.
    "types": ["node"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "strict": true
  },
  "include": ["src"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
