{
  "name": "@andrew_l/app",
  "version": "0.4.6",
  "description": "Application runner.",
  "keywords": [
    "app",
    "runner"
  ],
  "author": "Andrew L. <andrew.io.dev@gmail.com>",
  "license": "MIT",
  "homepage": "https://men232.github.io/toolkit/reference/@andrew_l/app/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/men232/toolkit.git",
    "directory": "packages/app"
  },
  "bugs": "https://github.com/men232/toolkit/issues",
  "type": "module",
  "scripts": {
    "check-types": "vue-tsc --noEmit",
    "build": "obuild",
    "prepack": "obuild",
    "test": "vitest run --typecheck",
    "test:watch": "vitest watch --typecheck"
  },
  "bin": {
    "vrun": "bin/vrun"
  },
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.mjs",
      "types": "./dist/index.d.mts"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@types/node": "catalog:",
    "obuild": "catalog:",
    "typescript": "catalog:",
    "unplugin-vue": "^7.2.0",
    "vitest": "catalog:",
    "vue-tsc": "^2.2.0"
  },
  "dependencies": {
    "@andrew_l/context": "workspace:*",
    "@andrew_l/graceful": "workspace:*",
    "@andrew_l/toolkit": "workspace:*",
    "@andrew_l/vue-stdout": "workspace:*",
    "commander": "^13.0.0",
    "consola": "^3.4.2",
    "dotenv": "^17.4.2",
    "vue": "3.5.13",
    "wrap-ansi": "^10.0.0"
  },
  "peerDependencies": {
    "tsx": "catalog:"
  }
}
